#include <windows.h>
#include "Resource.h"

IDI_STRATOCAM ICON "@STRATOCAM_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @STRATOCAM_VERSION_COMMA@,0
 PRODUCTVERSION @STRATOCAM_VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "StratoCam contributors\0"
            VALUE "FileDescription", "StratoCam USB camera controller\0"
            VALUE "FileVersion", "@STRATOCAM_VERSION@\0"
            VALUE "InternalName", "StratoCam\0"
            VALUE "LegalCopyright", "Licensed under Apache-2.0\0"
            VALUE "OriginalFilename", "StratoCam.exe\0"
            VALUE "ProductName", "StratoCam\0"
            VALUE "ProductVersion", "@STRATOCAM_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
